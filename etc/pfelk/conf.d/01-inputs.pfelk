# 01-inputs.pfelk
################################################################################
# Version: 26.10                                                               #
# Required: True                                                               #
# Description: Sets the type, port to listen, and initial grok pattern.        #
################################################################################
input {
  udp {
    id => "pfelk-udp"
    port => 5140
    tags => ["pfelk"]
  }

  tcp {
    id => "pfelk-tcp"
    port => 5140
    tags => ["pfelk"]
  }
}

filter {
  if "pfelk" in [tags] {

    # Preserve raw evidence immediately.
    if ![event][original] {
      mutate {
        copy => {
          "message" => "[event][original]"
        }
      }
    }

    grok {
      match => {
        "message" => "^<%{POSINT:[log][syslog][priority]:int}>%{GREEDYDATA:pfelk}$"
      }
      tag_on_failure => ["_pfelk_syslog_priority_failure"]
    }

    grok {
      patterns_dir => ["/etc/pfelk/patterns"]
      match => {
        "pfelk" => "%{PFELK}"
      }
      tag_on_failure => ["_pfelk_header_parse_failure"]
    }
  }
}
